{
  "name": "liliblog-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-vditor.mjs",
    "dev": "nuxt dev",
    "prebuild": "node scripts/copy-vditor.mjs",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "node scripts/copy-vditor.mjs && nuxt prepare",
    "dev:legacy": "node -e \"require('fs').cpSync('node_modules/vditor/dist','public/vditor/dist',{recursive:true})\" && vite",
    "build:legacy": "vue-tsc -b && vite build && npm run copy:vditor:legacy",
    "copy:vditor:legacy": "node -e \"require('fs').cpSync('node_modules/vditor/dist','dist/vditor/dist',{recursive:true})\""
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/nuxt": "^15.0.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-vue-next": "^0.511.0",
    "marked": "^18.0.7",
    "nprogress": "^0.2.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.3.0",
    "vditor": "^3.11.2",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.0.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "yarn@4.18.0"
}
